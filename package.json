{
  "name": "serene-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server --",
    "dev:client": "npm run dev -w client --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test:integration": "npm run test:integration -w server --",
    "test:db": "npm run test:db -w server --",
    "db:setup": "npm run db:setup -w server --",
    "db:generate": "npm run db:generate -w server --",
    "db:validate": "npm run db:validate -w server --",
    "db:migrate": "npm run db:migrate -w server --",
    "db:deploy": "npm run db:deploy -w server --",
    "db:reset": "npm run db:reset -w server --",
    "db:seed": "npm run db:seed -w server --",
    "ops:seed": "npm run ops:seed -w server --",
    "ops:bootstrap": "npm run ops:bootstrap -w server --",
    "ops:maintenance": "npm run ops:maintenance -w server --",
    "ops:backup": "npm run ops:backup -w server --",
    "ops:db-check": "npm run ops:db-check -w server --",
    "worker": "npm run worker -w server --"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
