{
  "name": "serene-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build && npm run build:ops",
    "build:ops": "node scripts/ops/build.mjs",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:db": "node node_modules/vitest/vitest.mjs run tests/db",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/setup-native-postgres.ps1",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "ops:seed": "node --conditions=react-server dist/ops/seed.mjs",
    "ops:bootstrap": "node --conditions=react-server dist/ops/bootstrap.mjs",
    "ops:maintenance": "node --conditions=react-server dist/ops/maintenance.mjs",
    "ops:backup": "node --conditions=react-server dist/ops/backup.mjs",
    "ops:db-check": "node --conditions=react-server dist/ops/db-check.mjs",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@reduxjs/toolkit": "^2.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
