# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose up -d starts one on 5432)
DATABASE_URL="postgresql://serene:serene@localhost:5432/serene_management?schema=public"

# JWT signing secrets: 32+ random bytes each, base64 (openssl rand -base64 48)
AUTH_ACCESS_TOKEN_SECRET=""
AUTH_REFRESH_TOKEN_SECRET=""
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# AES-256-GCM key for sensitive profile fields (guest ID documents): 32 bytes, base64
FIELD_ENCRYPTION_KEY=""

APP_URL="http://localhost:3000"
