# Copy to .env and fill in. Never commit .env.
# Production: see docs/DEPLOYMENT.md. With NODE_ENV=production the server refuses
# to start on placeholder or shared secrets, a localhost or http:// APP_URL, or a
# missing TRUSTED_PROXY_HOPS.

# PostgreSQL (native install). Replace change-me with a strong password (16+ chars),
# then create the role and databases once with: npm run db:setup
DATABASE_URL="postgresql://serene:change-me@localhost:5432/serene_management?schema=public"

# Production: DATABASE_URL is the runtime role (scripts/db/runtime-role.sql) and
# MIGRATION_DATABASE_URL the schema owner, used only by db:deploy and ops:backup
# (docs/OPERATIONS.md §4). Unset = DATABASE_URL is used for both (development).
# MIGRATION_DATABASE_URL=""

# Connection pool and session limits (docs/OPERATIONS.md §6). Defaults shown.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# JWT signing secrets: 32+ random bytes each, base64 (openssl rand -base64 48)
AUTH_ACCESS_TOKEN_SECRET=""
AUTH_REFRESH_TOKEN_SECRET=""
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# AES-256-GCM key for sensitive profile fields (guest ID documents): 32 bytes, base64
FIELD_ENCRYPTION_KEY=""

# Public URL. Production: https://, never localhost.
APP_URL="http://localhost:3000"

# Reverse proxies in front of the app that APPEND to X-Forwarded-For
# (docs/ARCHITECTURE.md D44). 0 = no proxy: forwarded headers are ignored, the
# client IP is unknown and IP-keyed rate limits are skipped (per-user and
# per-account limits still apply). Production behind nginx: 1.
TRUSTED_PROXY_HOPS=0

# Development seed only (npm run db:seed). Refused when NODE_ENV=production.
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=""   # 16+ characters, shared by every demo user, never printed

# Production first administrator (npm run ops:bootstrap). Do not keep the
# password here: prefer the interactive prompt, or set it for one command only.
# BOOTSTRAP_ADMIN_PASSWORD=
