# Copy to .env and fill in. Never commit .env.
# Production: see docs/DEPLOYMENT.md. With NODE_ENV=production the server refuses
# to start on placeholder or shared secrets, a localhost or http:// APP_URL, or a
# missing TRUSTED_PROXY_HOPS.

# PostgreSQL (native install). Replace change-me with a strong password (16+ chars),
# then create the role and databases once with: npm run db:setup
DATABASE_URL="postgresql://serene:change-me@localhost:5432/serene_management?schema=public"

# Production: DATABASE_URL is the runtime role (scripts/db/runtime-role.sql) and
# MIGRATION_DATABASE_URL the schema owner, used only by db:deploy and ops:backup
# (docs/OPERATIONS.md §4). Unset = DATABASE_URL is used for both (development).
# MIGRATION_DATABASE_URL=""

# Connection pool and session limits (docs/OPERATIONS.md §6). Defaults shown.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=0
# DATABASE_POOL_IDLE_TIMEOUT_MS=120000
# DATABASE_POOL_MAX_LIFETIME_S=0
# "pgbouncer-transaction" when DATABASE_URL points at a transaction-mode
# PgBouncer (docs/OPERATIONS.md §6): then set the session settings on the
# role and REALTIME_DATABASE_URL to a direct connection.
# DATABASE_POOLER=none
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# JWT signing secrets: 32+ random bytes each, base64 (openssl rand -base64 48)
AUTH_ACCESS_TOKEN_SECRET=""
AUTH_REFRESH_TOKEN_SECRET=""
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# AES-256-GCM key for sensitive profile fields (guest ID documents): 32 bytes, base64
FIELD_ENCRYPTION_KEY=""

# Public URL. Production: https://, never localhost.
APP_URL="http://localhost:3000"

# Reverse proxies in front of the app that APPEND to X-Forwarded-For
# (docs/ARCHITECTURE.md D44). 0 = no proxy: forwarded headers are ignored, the
# client IP is unknown and IP-keyed rate limits are skipped (per-user and
# per-account limits still apply). Production behind nginx: 1.
TRUSTED_PROXY_HOPS=0

# Rate-limit windows (docs/ARCHITECTURE.md D59): "postgres" (default) is shared by
# every application instance; "memory" counts per process and is only correct
# for a single process. Sign-in limits fail closed if the store is unreachable.
# RATE_LIMIT_STORE=postgres

# "1" adds Server-Timing (auth, per search type, total ms) to API responses for load tests only.
# SERVER_TIMING=0

# Global search: per-type queries run at once per request (docs/SCALABILITY.md §28).
# Keep well below DATABASE_POOL_MAX.
# SEARCH_CONCURRENCY=3

# Live updates (docs/SCALABILITY.md §31): "0" switches the event streams off
# and every screen polls as before. Each instance holds one LISTEN connection;
# LISTEN needs a session connection, so point REALTIME_DATABASE_URL at the
# database directly when DATABASE_URL goes through a transaction pooler.
# REALTIME_ENABLED=1
# REALTIME_DATABASE_URL=

# Background jobs (docs/SCALABILITY.md §33, docs/OPERATIONS.md §6). "inline" runs a
# worker in this process; "off" leaves jobs to `npm run worker` processes.
# JOB_WORKER=inline
# JOB_WORKER_CONCURRENCY=1
# JOB_POLL_INTERVAL_MS=5000
# JOB_LEASE_MS=60000

# Heavy reports computed at once per process; others wait, then answer 429.
# REPORT_HEAVY_CONCURRENCY=1
# REPORT_HEAVY_WAIT_MS=30000

# Optional read replica (docs/SCALABILITY.md §35). Unset: every query uses DATABASE_URL.
# When set, only closed-date reports may read there; everything else stays on the primary,
# and a replica that is down or lagging falls back to the primary.
# READ_DATABASE_URL=
# READ_DATABASE_POOL_MAX=3
# READ_REPLICA_MAX_LAG_MS=30000

# Several instances behind a load balancer (docs/OPERATIONS.md §10). On SIGTERM/SIGINT
# readiness answers 503 for SHUTDOWN_DRAIN_MS (≥ the balancer's check interval × unhealthy
# threshold), then in-flight requests finish; everything ends within SHUTDOWN_TIMEOUT_MS.
# INSTANCE_ID names this process in logs and (with SERVER_TIMING=1) the x-instance-id header.
# SHUTDOWN_DRAIN_MS=5000
# SHUTDOWN_TIMEOUT_MS=25000
# INSTANCE_ID=

# Development seed only (npm run db:seed). Refused when NODE_ENV=production.
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=""   # 16+ characters, shared by every demo user, never printed

# Production first administrator (npm run ops:bootstrap). Do not keep the
# password here: prefer the interactive prompt, or set it for one command only.
# BOOTSTRAP_ADMIN_PASSWORD=
