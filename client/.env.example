# Copy to client/.env.local. Never commit .env.local.
# Only NEXT_PUBLIC_* values are read by the client, and they are inlined at BUILD time
# (next build): changing one means rebuilding. Never put a secret here.

# Base URL of the Express API, including /api/v1. Also the origin allowed in the
# Content-Security-Policy connect-src. Production: the public https:// URL of the API;
# its origin must be listed in the server's CLIENT_ORIGINS (CORS).
# The default below is used when the variable is unset.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
