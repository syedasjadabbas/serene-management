{
  "name": "@serene/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch --clear-screen=false index.ts",
    "build": "node scripts/build.mjs && node scripts/ops/build.mjs",
    "build:ops": "node scripts/ops/build.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js .",
    "test": "node ../node_modules/vitest/vitest.mjs run --project unit",
    "test:watch": "node ../node_modules/vitest/vitest.mjs --project unit",
    "test:db": "node ../node_modules/vitest/vitest.mjs run --project unit tests/db",
    "test:integration": "node ../node_modules/vitest/vitest.mjs run --project integration",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db/setup-native-postgres.ps1",
    "db:generate": "node ../node_modules/prisma/build/index.js generate",
    "db:validate": "node ../node_modules/prisma/build/index.js validate",
    "db:migrate": "node ../node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node ../node_modules/prisma/build/index.js migrate deploy",
    "db:reset": "node ../node_modules/prisma/build/index.js migrate reset",
    "db:seed": "node ../node_modules/prisma/build/index.js db seed",
    "ops:seed": "node dist/ops/seed.mjs",
    "ops:bootstrap": "node dist/ops/bootstrap.mjs",
    "ops:maintenance": "node dist/ops/maintenance.mjs",
    "ops:backup": "node dist/ops/backup.mjs",
    "ops:db-check": "node dist/ops/db-check.mjs",
    "worker": "node dist/workers/worker.mjs",
    "postinstall": "node ../node_modules/prisma/build/index.js generate",
    "start": "node dist/index.mjs",
    "build:server": "node scripts/build.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serene/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.1"
  }
}
