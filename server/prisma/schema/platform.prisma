// Cross-cutting platform tables: audit trail, transactional outbox,
// idempotency and file attachments.

enum AuditRisk {
  LOW
  STANDARD
  HIGH

  @@map("audit_risk")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

/// Append-only audit trail. UPDATE/DELETE are rejected by a database trigger.
/// Written inside the same transaction as the change it describes.
/// High-volume: partition by month (created_at) before production scale.
model AuditLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  /// Null for system actors (night audit scheduler, integrations).
  userId         String?   @map("user_id") @db.Uuid
  actorType      String    @default("USER") @map("actor_type") @db.VarChar(20)
  /// e.g. "reservation.cancel", "folio.adjust", "room.status_change"
  action         String    @db.VarChar(80)
  resourceType   String    @map("resource_type") @db.VarChar(60)
  resourceId     String?   @map("resource_id") @db.VarChar(64)
  businessDate   DateTime? @map("business_date") @db.Date
  risk           AuditRisk @default(STANDARD)
  before         Json?
  after          Json?
  reasonCodeId   String?   @map("reason_code_id") @db.Uuid
  reason         String?   @db.VarChar(1000)
  requestId      String?   @map("request_id") @db.VarChar(64)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([propertyId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([propertyId, risk, createdAt(sort: Desc)])
  /// Phase 9: resource history of organization data (guests, companies) and
  /// the organization audit trail.
  @@index([organizationId, resourceId, createdAt(sort: Desc)])
  /// Phase 10 (H9): the organization audit trail (keyset newest first) and the
  /// audit-trail report by business date.
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_organization_id_created_at_idx")
  @@index([propertyId, businessDate], map: "audit_logs_property_id_business_date_idx")
  @@map("audit_logs")
}

/// Transactional outbox: domain events written in the business transaction,
/// then relayed to real-time subscribers (SSE) and integrations.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  propertyId    String?      @map("property_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  /// e.g. "room.status_changed", "reservation.checked_in"
  eventType     String       @map("event_type") @db.VarChar(80)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)

  @@index([occurredAt], map: "outbox_events_pending_idx", where: raw("status = 'PENDING'"))
  @@index([propertyId, occurredAt])
  @@map("outbox_events")
}

/// Replay protection for non-idempotent commands (payments, postings, check-in).
/// Clients send `Idempotency-Key`; the stored response is returned on retry.
model IdempotencyKey {
  key          String   @db.VarChar(80)
  userId       String   @map("user_id") @db.Uuid
  route        String   @db.VarChar(200)
  requestHash  String   @map("request_hash") @db.Char(64)
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// File metadata (photos, scanned documents, maintenance pictures). Bytes live
/// in object storage. `resourceType/resourceId` is the one intentional
/// polymorphic reference besides the audit log.
model Attachment {
  id           String    @id @default(uuid(7)) @db.Uuid
  propertyId   String?   @map("property_id") @db.Uuid
  resourceType String    @map("resource_type") @db.VarChar(60)
  resourceId   String    @map("resource_id") @db.Uuid
  storageKey   String    @unique @map("storage_key") @db.VarChar(500)
  fileName     String    @map("file_name") @db.VarChar(255)
  contentType  String    @map("content_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  /// Sensitive attachments (ID scans) require an elevated read permission.
  isSensitive  Boolean   @default(false) @map("is_sensitive")
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([resourceType, resourceId])
  @@map("attachments")
}

/// Shared rate-limit windows (scalability phase 2, lib/db/rate-limit-store.ts): one
/// fixed window per rule and key, counted atomically by every application instance.
/// The table is UNLOGGED (hand-written migration 20261201090100): counters are
/// short-lived and start afresh after a crash or failover.
model RateLimitWindow {
  key     String   @id @db.VarChar(400)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_windows")
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("background_job_status")
}

/// Durable background jobs (scalability phase 6, docs/SCALABILITY.md §33,
/// ARCHITECTURE D65): work too long for an HTTP request (night audit). A job is
/// written in the transaction of the request that asks for it; any worker of
/// any instance claims it with FOR UPDATE SKIP LOCKED under a lease
/// (`locked_by`, `locked_until`, renewed by heartbeat), and every later write
/// is fenced on (`locked_by`, `attempts`), so a worker that lost its lease can
/// change nothing. Expired leases are reclaimed and retried with exponential
/// backoff up to `max_attempts`, then FAILED. Inserts NOTIFY `serene_jobs`
/// (hand-written migration 20261220090000) so idle workers wake at once.
/// `payload` and `last_error` are internal and never leave the server.
model BackgroundJob {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  propertyId     String?             @map("property_id") @db.Uuid
  /// Handler key, e.g. "night_audit.run".
  kind           String              @db.VarChar(60)
  /// At most one QUEUED or RUNNING job per key (partial unique index).
  dedupeKey      String?             @map("dedupe_key") @db.VarChar(200)
  status         BackgroundJobStatus @default(QUEUED)
  payload        Json
  /// Public outcome for the requester (ids of what the job produced).
  result         Json?
  /// Public progress: { stage, done, total }.
  progress       Json?
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5) @map("max_attempts")
  runAfter       DateTime            @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedBy       String?             @map("locked_by") @db.VarChar(120)
  lockedUntil    DateTime?           @map("locked_until") @db.Timestamptz(3)
  heartbeatAt    DateTime?           @map("heartbeat_at") @db.Timestamptz(3)
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  /// Safe for the requester.
  errorCode      String?             @map("error_code") @db.VarChar(60)
  errorMessage   String?             @map("error_message") @db.VarChar(500)
  /// Internal diagnostics of the last failed attempt; never exposed.
  lastError      String?             @map("last_error") @db.VarChar(2000)
  createdById    String              @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?           @map("finished_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([dedupeKey], map: "background_jobs_active_dedupe_key", where: raw("status IN ('QUEUED', 'RUNNING') AND dedupe_key IS NOT NULL"))
  @@index([runAfter, id], map: "background_jobs_queued_idx", where: raw("status = 'QUEUED'"))
  @@index([lockedUntil], map: "background_jobs_running_idx", where: raw("status = 'RUNNING'"))
  @@index([propertyId, createdAt(sort: Desc)])
  @@index([finishedAt], map: "background_jobs_finished_idx", where: raw("finished_at IS NOT NULL"))
  @@map("background_jobs")
}
